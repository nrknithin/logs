  NEW.var_name, 
  NEW.cache_name, 
  (NEW.json_value->'field1')\:\:numeric as field1MappedField, 
  (NEW.json_value->>'field3')\:\:text as field2MappedField; 
RETURN NEW; 
END; 
$$ LANGUAGE PLPGSQL; 

