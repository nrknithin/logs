package org.drools.compiler.test 

import org.drools.mvel.compiler.Cheese

global java.util.List list

function boolean testIllegalChars(  ) {
    return ( 3 < 4 && 4 > 3 );
}


rule "test MAIN 1"
    salience 10
    dialect "java"
when
    Cheese( $type : type, eval( 3 < 4 && 4 > 3 ), price < ( new Integer( 100 ) ) )  
    eval( 3 < 4 && 4 > 3 ) 
    eval( testIllegalChars() ) 
then
// lets also make sure that special chars are converted
        if ( 3 < 4 && 4 > 3 ) {
            list.add( "MAIN" );
            drools.setFocus( "agenda group 1" );
        }



end

rule "test group1 1"
    agenda-group "agenda group 1"
    dialect "java"
when
    Cheese( $price : price )  
then
list.add( "1 1" );


end

rule "test group3 1"
    salience 5
    agenda-group "agenda group 3"
    activation-group "internalMatch group 3"
    auto-focus true
    dialect "java"
when
    Cheese(  )  
then
list.add( "3 1" );


end

rule "test group3 2"
    agenda-group "agenda group 3"
    activation-group "internalMatch group 3"
    dialect "java"
when
    Cheese( $type : type, $price : price )  
then
list.add( "3 2" );


end



